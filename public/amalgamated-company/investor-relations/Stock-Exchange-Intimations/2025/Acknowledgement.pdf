            font-size: 13px !important;
        }
    </style>

    <script lang="javascript" type="text/javascript">


        function progressbar(flag) {
            if (flag = 1) {

                $('#dvLoader').css('display', 'block');
            }
            else {
                $('#dvLoader').css('display', 'none');
            }
        }

        function Clrlable(Source, args) {
            $('#StatusLabel').text("");
            $('#StatusLabel').css("color", "black");
            args.IsValid = true; // Valid file type
        }

        function ValidateFileUpload1() {

            var fuData = document.getElementById('FileUploadControl');            
            var FileUploadPath = fuData.value;
            
            
            var isScripCodeSelected = IsScripCodeSelected();
            if (isScripCodeSelected == false)
                return false;

            if (FileUploadPath == '') {
                // There is no file selected 
                $('#StatusLabel').text("Please select valid .xml file.");
                $('#StatusLabel').css("color", "Red");
                return false;
            }
            else {
                var Extension = FileUploadPath.substring(FileUploadPath.lastIndexOf('.') + 1).toLowerCase();

                if (Extension == "xml") {
                    return true; // Valid file type
                }
                else {

                    fuData.value = "";
                    $('#StatusLabel').text("Please select valid .xml file.");
                    $('#StatusLabel').css("color", "Red");
                    return false; // Not valid file type
                }
            }
        }

        function OpenP() {
            $('#btnmsg').click();
        }
        function ExistFile() {
            $('#btnexistfile').click();
        }
        function OpenAck() {
            $('#btnvalidate').click();
        }
        function Success(msg) {
            alert(msg);
        }
        function CloseAck() {
            $('#btnclose').click();
        }
        function disablebtn() {
            $('#btnResubContinue').attr('disabled', 'disabled');
        }
    </script>
</head>
